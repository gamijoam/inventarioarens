APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_BOOTSTRAP_TOKEN=
LARAVEL_STORAGE_PATH=
LOCAL_TECHNICAL_CONSOLE_ENABLED=true
LOCAL_TECHNICAL_CONSOLE_CLOUD_URL=https://app.miinventariofacil.com/api

DB_CONNECTION=sqlite
DB_DATABASE=storage/app/inventario.sqlite
DB_FOREIGN_KEYS=true
DB_BUSY_TIMEOUT=5000
DB_JOURNAL_MODE=WAL
DB_SYNCHRONOUS=NORMAL
DB_TRANSACTION_MODE=IMMEDIATE

# La sincronizacion sigue usando HTTPS contra el VPS.
SYNC_CLOUD_URL=https://app.miinventariofacil.com/api
SYNC_CLOUD_TOKEN=
